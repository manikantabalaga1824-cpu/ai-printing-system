# Configure these in your hosting platform's private environment settings.
# Do not put real secrets in this file or in browser-side JavaScript.
GEMINI_API_KEY=
# Optional: override only with an image-capable model available to your project.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Optional for Vercel's API route. Comma-separated frontend origins allowed to call it.
# Leave blank for same-origin deployments. Example: https://your-site.example
ALLOWED_ORIGINS=
